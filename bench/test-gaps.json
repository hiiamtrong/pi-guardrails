    "id": "slugify", "file": "src/slug.ts",
    "source": [
      "export function slugify(title: string): string {",
      "  return title",
      "    .toLowerCase()",
      "    .trim()",
      "    .replace(/[^a-z0-9]+/g, \"-\")",
      "    .replace(/^-|-$/g, \"\");",
      "}"
    ],
    "relevance": { "happy": "yes", "empty": "yes", "null": "either", "limit": "no", "past_limit": "no", "negative": "no", "malformed": "yes", "dependency": "no", "duplicates": "either" },
    "suites": [
      { "variant": "happy", "covers": ["happy"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { slugify } from \"../src/slug.ts\";", "",
        "test(\"slugifies a title\", () => assert.equal(slugify(\"Hello World\"), \"hello-world\"));"] },
      { "variant": "errors", "covers": ["happy", "empty"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { slugify } from \"../src/slug.ts\";", "",
        "test(\"slugifies a title\", () => assert.equal(slugify(\"Hello World\"), \"hello-world\"));",
        "test(\"returns empty for empty input\", () => assert.equal(slugify(\"\"), \"\"));"] },
      { "variant": "full", "covers": ["happy", "empty", "malformed", "duplicates", "null"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { slugify } from \"../src/slug.ts\";", "",
        "test(\"slugifies a title\", () => assert.equal(slugify(\"Hello World\"), \"hello-world\"));",
        "test(\"returns empty for empty input\", () => assert.equal(slugify(\"\"), \"\"));",
        "test(\"drops symbols and accents\", () => {", "  assert.equal(slugify(\"!!!\"), \"\");", "  assert.equal(slugify(\"Déjà vu\"), \"d-j-vu\");", "});",
        "test(\"collapses repeated separators\", () => assert.equal(slugify(\"a -- b\"), \"a-b\"));",
        "test(\"throws on null\", () => assert.throws(() => slugify(null as unknown as string), TypeError));"] },
      { "variant": "noassert", "covers": [], "tests": [
        "import test from \"node:test\";", "import { slugify } from \"../src/slug.ts\";", "",
        "test(\"smoke\", () => {", "  slugify(\"Hello World\");", "  slugify(\"\");", "  slugify(\"!!!\");", "});"] },
      { "variant": "mixed", "covers": ["happy", "malformed"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { slugify } from \"../src/slug.ts\";", "",
        "test(\"slugifies a title\", () => assert.equal(slugify(\"Hello World\"), \"hello-world\"));",
        "test(\"strips punctuation\", () => assert.equal(slugify(\"C++ & Rust!\"), \"c-rust\"));"] }
