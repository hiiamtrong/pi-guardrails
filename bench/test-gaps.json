    "id": "parse_config", "file": "config.py",
    "source": [
      "import json",
      "",
      "",
      "def parse_config(text: str) -> dict:",
      "    if not text.strip():",
      "        raise ValueError(\"config is empty\")",
      "    data = json.loads(text)",
      "    if not isinstance(data, dict):",
      "        raise ValueError(\"config must be a JSON object\")",
      "    return {\"port\": int(data.get(\"port\", 8080)), \"debug\": bool(data.get(\"debug\", False))}"
    ],
    "relevance": { "happy": "yes", "empty": "yes", "null": "either", "limit": "no", "past_limit": "no", "negative": "either", "malformed": "yes", "dependency": "no", "duplicates": "no" },
    "suites": [
      { "variant": "happy", "covers": ["happy"], "tests": [
        "from config import parse_config", "", "",
        "def test_parses_port():", "    assert parse_config('{\"port\": 9000}') == {\"port\": 9000, \"debug\": False}"] },
      { "variant": "errors", "covers": ["happy", "empty", "err:config is empty", "err:JSON object"], "either": ["malformed"], "tests": [
        "import pytest", "", "from config import parse_config", "", "",
        "def test_parses_port():", "    assert parse_config('{\"port\": 9000}') == {\"port\": 9000, \"debug\": False}", "", "",
        "def test_rejects_blank_text():", "    with pytest.raises(ValueError, match=\"config is empty\"):", "        parse_config(\"   \")", "", "",
        "def test_rejects_non_object():", "    with pytest.raises(ValueError, match=\"JSON object\"):", "        parse_config(\"[1, 2]\")"] },
      { "variant": "full", "covers": ["happy", "empty", "malformed", "err:config is empty", "err:JSON object"], "tests": [
        "import json", "", "import pytest", "", "from config import parse_config", "", "",
        "def test_parses_port():", "    assert parse_config('{\"port\": 9000}') == {\"port\": 9000, \"debug\": False}", "", "",
        "def test_applies_defaults():", "    assert parse_config(\"{}\") == {\"port\": 8080, \"debug\": False}", "", "",
        "def test_rejects_blank_text():", "    with pytest.raises(ValueError, match=\"config is empty\"):", "        parse_config(\"   \")", "", "",
        "def test_rejects_invalid_json():", "    with pytest.raises(json.JSONDecodeError):", "        parse_config(\"{\")", "", "",
        "def test_rejects_non_object():", "    with pytest.raises(ValueError, match=\"JSON object\"):", "        parse_config(\"[1, 2]\")"] },
      { "variant": "noassert", "covers": [], "tests": [
        "from config import parse_config", "", "",
        "def test_smoke():", "    parse_config('{\"port\": 9000}')", "    try:", "        parse_config(\"\")", "    except ValueError:", "        pass"] },
      { "variant": "mixed", "covers": ["happy", "malformed"], "tests": [
        "import json", "", "import pytest", "", "from config import parse_config", "", "",
        "def test_parses_port():", "    assert parse_config('{\"port\": 9000}') == {\"port\": 9000, \"debug\": False}", "", "",
        "def test_rejects_invalid_json():", "    with pytest.raises(json.JSONDecodeError):", "        parse_config(\"{\")"] }
    ]
  },
