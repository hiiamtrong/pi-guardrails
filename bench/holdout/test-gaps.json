    "id": "LoadUser", "file": "users/load.go",
    "source": [
      "package users",
      "",
      "import (",
      "\t\"errors\"",
      "\t\"fmt\"",
      ")",
      "",
      "type Repo interface{ Find(id int) (User, error) }",
      "",
      "func LoadUser(repo Repo, id int) (User, error) {",
      "\tif id <= 0 {",
      "\t\treturn User{}, errors.New(\"invalid id\")",
      "\t}",
      "\tu, err := repo.Find(id)",
      "\tif err != nil {",
      "\t\treturn User{}, fmt.Errorf(\"load user: %w\", err)",
      "\t}",
      "\tif u.Deleted {",
      "\t\treturn User{}, errors.New(\"user deleted\")",
      "\t}",
      "\treturn u, nil",
      "}"
    ],
