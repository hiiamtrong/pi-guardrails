    "id": "transfer", "file": "bank.py",
    "source": [
      "def transfer(balance: int, amount: int) -> int:",
      "    if amount <= 0:",
      "        raise ValueError(\"amount must be positive\")",
      "    if amount > balance:",
      "        raise ValueError(\"insufficient funds\")",
      "    return balance - amount"
    ],
    "relevance": { "happy": "yes", "empty": "no", "null": "either", "limit": "yes", "past_limit": "yes", "negative": "yes", "malformed": "either", "dependency": "no", "duplicates": "no" },
    "suites": [
      { "variant": "happy", "covers": ["happy"], "tests": [
        "from bank import transfer", "", "",
        "def test_transfer():", "    assert transfer(100, 30) == 70"] },
      { "variant": "errors", "covers": ["happy", "negative", "err:must be positive", "err:insufficient funds"], "either": ["past_limit"], "tests": [
        "import pytest", "", "from bank import transfer", "", "",
        "def test_transfer():", "    assert transfer(100, 30) == 70", "", "",
        "def test_rejects_zero_amount():", "    with pytest.raises(ValueError, match=\"must be positive\"):", "        transfer(100, 0)", "", "",
        "def test_rejects_overdraft():", "    with pytest.raises(ValueError, match=\"insufficient funds\"):", "        transfer(100, 200)"] },
      { "variant": "full", "covers": ["happy", "limit", "past_limit", "negative", "err:must be positive", "err:insufficient funds"], "tests": [
        "import pytest", "", "from bank import transfer", "", "",
        "def test_transfer():", "    assert transfer(100, 30) == 70", "", "",
        "def test_transfer_whole_balance():", "    assert transfer(100, 100) == 0", "", "",
        "@pytest.mark.parametrize(\"amount\", [0, -5])",
        "def test_rejects_non_positive_amounts(amount):", "    with pytest.raises(ValueError, match=\"must be positive\"):", "        transfer(100, amount)", "", "",
        "def test_rejects_one_over_balance():", "    with pytest.raises(ValueError, match=\"insufficient funds\"):", "        transfer(100, 101)"] },
      { "variant": "noassert", "covers": [], "tests": [
        "from bank import transfer", "", "",
        "def test_smoke():", "    transfer(100, 30)", "    try:", "        transfer(100, 0)", "    except ValueError:", "        pass"] },
      { "variant": "mixed", "covers": ["happy", "limit"], "tests": [
        "from bank import transfer", "", "",
        "def test_transfer():", "    assert transfer(100, 30) == 70", "", "",
        "def test_transfer_whole_balance():", "    assert transfer(100, 100) == 0"] }
    ]
  },
