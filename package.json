{
  "name": "pi-guardrails",
  "version": "1.0.0",
  "description": "Pi extension that permits GitHub reads and confirms remote writes",
  "type": "module",
  "license": "MIT",
  "files": ["extensions", "config"],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": ["pi-package", "pi-extension", "github", "security"],
  "scripts": {
    "test": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": ["./extensions/comment-guard.ts", "./extensions/github-write-confirm.ts", "./extensions/github-identity-guard-required.ts", "./extensions/pr-review-archive.ts", "./extensions/worktree-bootstrap.ts"]
  }
}
