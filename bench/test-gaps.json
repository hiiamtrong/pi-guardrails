    "id": "fetchUser", "file": "src/users.ts",
    "source": [
      "type Http = { get(url: string): Promise<{ status: number; body: unknown }> };",
      "",
      "export async function fetchUser(http: Http, id: string) {",
      "  if (!/^[a-z0-9-]+$/.test(id)) throw new Error(\"invalid user id\");",
      "  const res = await http.get(\"/users/\" + id);",
      "  if (res.status === 404) throw new Error(\"user not found\");",
      "  if (res.status !== 200) throw new Error(\"unexpected status\");",
      "  return res.body as { id: string; name: string };",
      "}"
    ],
    "relevance": { "happy": "yes", "empty": "yes", "null": "either", "limit": "no", "past_limit": "no", "negative": "no", "malformed": "yes", "dependency": "yes", "duplicates": "no" },
    "suites": [
      { "variant": "happy", "covers": ["happy"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { fetchUser } from \"../src/users.ts\";", "",
        "const http = (status: number, body: unknown = {}) => ({ get: async () => ({ status, body }) });", "",
        "test(\"returns the user body\", async () => {",
        "  assert.deepEqual(await fetchUser(http(200, { id: \"u1\", name: \"Ann\" }), \"u1\"), { id: \"u1\", name: \"Ann\" });",
        "});"] },
      { "variant": "errors", "covers": ["happy", "malformed", "err:invalid user id", "err:user not found", "err:unexpected status"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { fetchUser } from \"../src/users.ts\";", "",
        "const http = (status: number, body: unknown = {}) => ({ get: async () => ({ status, body }) });", "",
        "test(\"returns the user body\", async () => {",
        "  assert.deepEqual(await fetchUser(http(200, { id: \"u1\", name: \"Ann\" }), \"u1\"), { id: \"u1\", name: \"Ann\" });",
        "});",
        "test(\"maps 404 to not found\", async () => {", "  await assert.rejects(fetchUser(http(404), \"u1\"), /user not found/);", "});",
        "test(\"rejects other statuses\", async () => {", "  await assert.rejects(fetchUser(http(500), \"u1\"), /unexpected status/);", "});",
        "test(\"rejects malformed ids\", async () => {", "  await assert.rejects(fetchUser(http(200), \"BAD ID!\"), /invalid user id/);", "});"] },
      { "variant": "full", "covers": ["happy", "empty", "malformed", "dependency", "err:invalid user id", "err:user not found", "err:unexpected status"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { fetchUser } from \"../src/users.ts\";", "",
        "const http = (status: number, body: unknown = {}) => ({ get: async () => ({ status, body }) });", "",
        "test(\"returns the user body\", async () => {",
        "  assert.deepEqual(await fetchUser(http(200, { id: \"u1\", name: \"Ann\" }), \"u1\"), { id: \"u1\", name: \"Ann\" });",
        "});",
        "test(\"maps 404 to not found\", async () => {", "  await assert.rejects(fetchUser(http(404), \"u1\"), /user not found/);", "});",
        "test(\"rejects other statuses\", async () => {", "  await assert.rejects(fetchUser(http(500), \"u1\"), /unexpected status/);", "});",
        "test(\"rejects malformed and empty ids\", async () => {",
        "  await assert.rejects(fetchUser(http(200), \"BAD ID!\"), /invalid user id/);",
        "  await assert.rejects(fetchUser(http(200), \"\"), /invalid user id/);",
        "});",
        "test(\"propagates network failures\", async () => {",
        "  const failing = { get: async () => { throw new Error(\"socket hang up\"); } };",
        "  await assert.rejects(fetchUser(failing, \"u1\"), /socket hang up/);",
        "});"] },
      { "variant": "noassert", "covers": [], "tests": [
