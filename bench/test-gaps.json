    "id": "dedupe_emails", "file": "emails.py",
    "source": [
      "import re",
      "",
      "EMAIL = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[a-z]+$\")",
      "",
      "",
      "def dedupe_emails(emails: list[str]) -> list[str]:",
      "    seen = []",
      "    for raw in emails:",
      "        email = raw.strip().lower()",
      "        if not EMAIL.match(email):",
      "            raise ValueError(\"invalid email: \" + raw)",
      "        if email not in seen:",
      "            seen.append(email)",
      "    return seen"
    ],
    "relevance": { "happy": "yes", "empty": "yes", "null": "either", "limit": "no", "past_limit": "no", "negative": "no", "malformed": "yes", "dependency": "no", "duplicates": "yes" },
    "suites": [
      { "variant": "happy", "covers": ["happy"], "tests": [
        "from emails import dedupe_emails", "", "",
        "def test_keeps_a_valid_email():", "    assert dedupe_emails([\"a@x.com\"]) == [\"a@x.com\"]"] },
      { "variant": "errors", "covers": ["happy", "malformed", "err:invalid email"], "tests": [
        "import pytest", "", "from emails import dedupe_emails", "", "",
        "def test_keeps_a_valid_email():", "    assert dedupe_emails([\"a@x.com\"]) == [\"a@x.com\"]", "", "",
        "def test_rejects_invalid_email():", "    with pytest.raises(ValueError, match=\"invalid email\"):", "        dedupe_emails([\"not-an-email\"])"] },
      { "variant": "full", "covers": ["happy", "empty", "malformed", "duplicates", "err:invalid email"], "tests": [
        "import pytest", "", "from emails import dedupe_emails", "", "",
        "def test_keeps_a_valid_email():", "    assert dedupe_emails([\"a@x.com\"]) == [\"a@x.com\"]", "", "",
        "def test_empty_list():", "    assert dedupe_emails([]) == []", "", "",
        "def test_dedupes_case_and_whitespace():", "    assert dedupe_emails([\"A@x.com\", \" a@x.com \"]) == [\"a@x.com\"]", "", "",
        "def test_rejects_invalid_email():", "    with pytest.raises(ValueError, match=\"invalid email\"):", "        dedupe_emails([\"not-an-email\"])"] },
      { "variant": "noassert", "covers": [], "tests": [
        "from emails import dedupe_emails", "", "",
        "def test_smoke():", "    dedupe_emails([\"a@x.com\", \"a@x.com\"])", "    dedupe_emails([])"] },
      { "variant": "mixed", "covers": ["happy", "duplicates"], "tests": [
        "from emails import dedupe_emails", "", "",
        "def test_keeps_a_valid_email():", "    assert dedupe_emails([\"a@x.com\"]) == [\"a@x.com\"]", "", "",
        "def test_dedupes_case_and_whitespace():", "    assert dedupe_emails([\"A@x.com\", \" a@x.com \"]) == [\"a@x.com\"]"] }
    ]
  },
