    "id": "ParsePort", "file": "netutil/port.go",
    "source": [
      "package netutil",
      "",
      "import (",
      "\t\"fmt\"",
      "\t\"strconv\"",
      ")",
      "",
      "func ParsePort(s string) (int, error) {",
      "\tp, err := strconv.Atoi(s)",
      "\tif err != nil {",
      "\t\treturn 0, fmt.Errorf(\"invalid port %q\", s)",
      "\t}",
      "\tif p < 1 || p > 65535 {",
      "\t\treturn 0, fmt.Errorf(\"port out of range: %d\", p)",
      "\t}",
      "\treturn p, nil",
      "}"
    ],
