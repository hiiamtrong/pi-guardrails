{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi GitHub write-confirm configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "writeAllowlist": {
      "description": "GitHub owner/repo names allowed to mutate without an interactive confirmation.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
      },
      "default": []
    }
  }
}
