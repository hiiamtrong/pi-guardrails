  {
    "id": "parseAge", "file": "src/age.ts",
    "source": [
      "export function parseAge(input: string): number {",
      "  const text = input.trim();",
      "  if (text === \"\") throw new Error(\"age is required\");",
      "  if (!/^\\d+$/.test(text)) throw new Error(\"age must be a whole number\");",
      "  const age = Number(text);",
      "  if (age > 150) throw new Error(\"age is unrealistic\");",
      "  return age;",
      "}"
    ],
    "relevance": { "happy": "yes", "empty": "yes", "null": "either", "limit": "yes", "past_limit": "yes", "negative": "yes", "malformed": "yes", "dependency": "no", "duplicates": "no" },
    "suites": [
      { "variant": "happy", "covers": ["happy"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { parseAge } from \"../src/age.ts\";", "",
        "test(\"parses a typical age\", () => assert.equal(parseAge(\"30\"), 30));"] },
      { "variant": "errors", "covers": ["happy", "empty", "malformed", "past_limit", "err:age is required", "err:whole number", "err:unrealistic"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { parseAge } from \"../src/age.ts\";", "",
        "test(\"parses a typical age\", () => assert.equal(parseAge(\"30\"), 30));",
        "test(\"rejects empty input\", () => assert.throws(() => parseAge(\"\"), /age is required/));",
        "test(\"rejects non-numeric input\", () => assert.throws(() => parseAge(\"abc\"), /whole number/));",
        "test(\"rejects ages above 150\", () => assert.throws(() => parseAge(\"151\"), /unrealistic/));"] },
      { "variant": "full", "covers": ["happy", "empty", "null", "limit", "past_limit", "negative", "malformed", "err:age is required", "err:whole number", "err:unrealistic"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { parseAge } from \"../src/age.ts\";", "",
        "test(\"parses a typical age\", () => assert.equal(parseAge(\"30\"), 30));",
        "test(\"trims whitespace\", () => assert.equal(parseAge(\"  42 \"), 42));",
        "test(\"rejects empty input\", () => assert.throws(() => parseAge(\"\"), /age is required/));",
        "test(\"rejects non-numeric input\", () => assert.throws(() => parseAge(\"abc\"), /whole number/));",
        "test(\"accepts the limits 0 and 150\", () => {", "  assert.equal(parseAge(\"0\"), 0);", "  assert.equal(parseAge(\"150\"), 150);", "});",
        "test(\"rejects ages above 150\", () => assert.throws(() => parseAge(\"151\"), /unrealistic/));",
        "test(\"rejects negative and decimal numbers\", () => {", "  assert.throws(() => parseAge(\"-5\"), /whole number/);", "  assert.throws(() => parseAge(\"4.5\"), /whole number/);", "});",
        "test(\"rejects null at runtime\", () => assert.throws(() => parseAge(null as unknown as string), TypeError));"] },
      { "variant": "noassert", "covers": [], "tests": [
        "import test from \"node:test\";", "import { parseAge } from \"../src/age.ts\";", "",
        "test(\"smoke\", () => {", "  parseAge(\"30\");", "  parseAge(\"150\");", "  try { parseAge(\"\"); } catch {}", "  try { parseAge(\"abc\"); } catch {}", "  try { parseAge(\"151\"); } catch {}", "});"] },
      { "variant": "mixed", "covers": ["happy", "limit", "past_limit", "negative", "err:unrealistic", "err:whole number"], "either": ["malformed"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { parseAge } from \"../src/age.ts\";", "",
        "test(\"parses a typical age\", () => assert.equal(parseAge(\"30\"), 30));",
        "test(\"accepts 150\", () => assert.equal(parseAge(\"150\"), 150));",
        "test(\"rejects 151\", () => assert.throws(() => parseAge(\"151\"), /unrealistic/));",
