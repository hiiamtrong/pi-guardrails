  {
    "id": "withRetry", "file": "src/retry.ts",
    "source": [
      "export async function withRetry<T>(fn: () => Promise<T>, attempts: number): Promise<T> {",
      "  if (attempts < 1) throw new RangeError(\"attempts must be at least 1\");",
      "  let lastError: unknown;",
      "  for (let i = 0; i < attempts; i++) {",
      "    try {",
      "      return await fn();",
      "    } catch (error) {",
      "      lastError = error;",
      "    }",
      "  }",
      "  throw lastError;",
      "}"
    ],
    "relevance": { "happy": "yes", "empty": "no", "null": "no", "limit": "either", "past_limit": "either", "negative": "yes", "malformed": "no", "dependency": "yes", "duplicates": "no" },
    "suites": [
      { "variant": "happy", "covers": ["happy"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { withRetry } from \"../src/retry.ts\";", "",
        "test(\"returns the first successful result\", async () => assert.equal(await withRetry(async () => 42, 3), 42));"] },
      { "variant": "errors", "covers": ["happy", "negative", "err:at least 1"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { withRetry } from \"../src/retry.ts\";", "",
        "test(\"returns the first successful result\", async () => assert.equal(await withRetry(async () => 42, 3), 42));",
        "test(\"rejects zero attempts\", async () => {", "  await assert.rejects(withRetry(async () => 1, 0), /at least 1/);", "});"] },
      { "variant": "full", "covers": ["happy", "negative", "limit", "past_limit", "dependency", "err:at least 1"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { withRetry } from \"../src/retry.ts\";", "",
        "test(\"returns the first successful result\", async () => assert.equal(await withRetry(async () => 42, 3), 42));",
        "test(\"rejects zero attempts\", async () => {", "  await assert.rejects(withRetry(async () => 1, 0), /at least 1/);", "});",
        "test(\"succeeds on the last attempt\", async () => {",
        "  let calls = 0;",
        "  const result = await withRetry(async () => {",
        "    calls += 1;",
        "    if (calls < 3) throw new Error(\"flaky\");",
        "    return \"ok\";",
        "  }, 3);",
        "  assert.equal(result, \"ok\");",
        "  assert.equal(calls, 3);",
        "});",
        "test(\"rethrows the last error after all attempts fail\", async () => {",
        "  await assert.rejects(withRetry(async () => { throw new Error(\"down\"); }, 2), /down/);",
        "});"] },
      { "variant": "noassert", "covers": [], "tests": [
        "import test from \"node:test\";", "import { withRetry } from \"../src/retry.ts\";", "",
        "test(\"smoke\", async () => {", "  await withRetry(async () => 42, 3);", "  await withRetry(async () => { throw new Error(\"down\"); }, 2).catch(() => {});", "});"] },
      { "variant": "mixed", "covers": ["happy", "dependency"], "either": ["past_limit"], "tests": [
        "import assert from \"node:assert/strict\";", "import test from \"node:test\";", "import { withRetry } from \"../src/retry.ts\";", "",
        "test(\"returns the first successful result\", async () => assert.equal(await withRetry(async () => 42, 3), 42));",
        "test(\"rethrows the last error after all attempts fail\", async () => {",
        "  await assert.rejects(withRetry(async () => { throw new Error(\"down\"); }, 2), /down/);",
        "});"] }
    ]
