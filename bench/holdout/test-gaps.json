    "id": "split_bill", "file": "bill.py",
    "source": [
      "def split_bill(total_cents: int, people: int) -> list[int]:",
      "    if people < 1:",
      "        raise ValueError(\"people must be at least 1\")",
      "    if total_cents < 0:",
      "        raise ValueError(\"total must not be negative\")",
      "    share, remainder = divmod(total_cents, people)",
      "    return [share + 1 if i < remainder else share for i in range(people)]"
    ],
    "relevance": { "happy": "yes", "empty": "no", "null": "either", "limit": "yes", "past_limit": "yes", "negative": "yes", "malformed": "either", "dependency": "no", "duplicates": "no" },
