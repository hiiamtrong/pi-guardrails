    "id": "Divide", "file": "calc/calc.go",
    "source": [
      "package calc",
      "",
      "import \"errors\"",
      "",
      "func Divide(a, b int) (int, error) {",
      "\tif b == 0 {",
      "\t\treturn 0, errors.New(\"division by zero\")",
      "\t}",
      "\treturn a / b, nil",
      "}"
